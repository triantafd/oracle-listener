{
  "name": "oracle-listener",
  "version": "0.1.1",
  "description": "Config-driven EVM oracle event listener library",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "pub": "npm run build && npm version patch && npm publish"
  },
  "author": "triantdc",
  "repository": {
    "type": "git",
    "url": "https://github.com/triantafd/oracle-listener.git"
  },
  "dependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ]
}
